<?xml version="1.0" encoding="utf-8"?>
<!-- Window changes only: which app is in front and whether the status bar is on screen, so the island can step
     aside in full screen apps and in the apps you chose. Android only hands out the list of windows to a service that
     may read window content; Drip looks at where the windows are, and only in a music app that plays at its seek bar and
     the song's title (IslandService follows that app's changes for this while it is in front). The volume buttons are
     only taken while an opened volume or music card shows the volume itself, so Android's panel does not open on top
     of it; at any other moment they go on to Android untouched. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowsChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows|flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="80"
    android:isAccessibilityTool="false"
    android:description="@string/island_service_description"
    android:summary="@string/island_service_summary" />
