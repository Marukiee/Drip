    <!-- Permissions -->
    <string name="perm_island">The island</string>
    <string name="perm_island_why">Switch Drip on under Accessibility. It only draws the island and does your gestures, and never reads what is on your screen.</string>
    <string name="perm_listener">Notification access</string>
    <string name="perm_listener_why">So the island can show music, calls, timers and notifications. Nothing leaves your phone.</string>
    <string name="perm_post">Update notices</string>
    <string name="perm_post_why">Only to tell you when a new version is ready to install.</string>
    <string name="perm_restricted">Is the switch grey in Android? Open App info, tap the menu at the top right and choose Allow restricted settings.</string>
